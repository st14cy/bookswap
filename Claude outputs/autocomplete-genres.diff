+/** Общие классы для выпадающих списков (Autocomplete, Combobox) */
+export const dropdownInputClass =
+    'w-full bg-gray rounded-12 py-22 px-20 text-16 placeholder:text-16';
+export const dropdownListClass =
+    'absolute left-0 right-0 top-full z-20 mt-1 max-h-72 overflow-auto rounded-12 bg-white shadow-lg border border-gray py-1';
+export const dropdownOptionClass = 'px-20 py-2 cursor-pointer select-none';
+export const dropdownOptionActiveClass = 'bg-gray';
+export const dropdownHintClass = 'px-20 py-2 text-black/50';
